<Grid x:Class="FreeClipControl.Shell.PopupSurface"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:FreeClipControl.Shell">
 <!-- A transparent center and fixed corners/edge thickness. No content alpha
      or offscreen XAML element is sampled to construct the shadow. -->
 <Image x:Name="ShadowImage" Source="Assets/PopupShadow.png" NineGrid="32"
        Stretch="Fill" IsHitTestVisible="False" Opacity="0.22"
        ImageOpened="OnShadowOpened" ImageFailed="OnShadowFailed" />
 <local:EarphonePanel x:Name="ContentPanel" Margin="12" />
</Grid>
