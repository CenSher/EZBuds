<UserControl x:Class="FreeClipControl.Shell.EarphonePanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:FreeClipControl.Shell" FontSize="15" FontWeight="Medium">
 <UserControl.Resources>
  <ResourceDictionary>
   <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
     <!-- Calibrated from the reported 243 -> 245 sample: (255 - 243) / 6 = 2. -->
     <SolidColorBrush x:Key="PanelBrightnessBrush" Color="White" Opacity="0.16666667" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
     <SolidColorBrush x:Key="PanelBrightnessBrush" Color="Transparent" />
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
     <SolidColorBrush x:Key="PanelBrightnessBrush" Color="Transparent" />
    </ResourceDictionary>
   </ResourceDictionary.ThemeDictionaries>
   <Style x:Key="HeadsetHeaderButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="0" /><Setter Property="MinWidth" Value="0" /><Setter Property="MinHeight" Value="28" />
    <Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="UseSystemFocusVisuals" Value="True" />
    <Setter Property="Template">
     <Setter.Value><ControlTemplate TargetType="Button">
      <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                        Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Center" />
     </ControlTemplate></Setter.Value>
    </Setter>
   </Style>
  </ResourceDictionary>
 </UserControl.Resources>
 <Border x:Name="Surface" CornerRadius="{ThemeResource OverlayCornerRadius}"
         BorderThickness="1" BorderBrush="{ThemeResource SurfaceStrokeColorDefaultBrush}">
  <Grid x:Name="ContentHost">
   <SystemBackdropElement x:Name="Material" CornerRadius="{ThemeResource OverlayCornerRadius}">
    <SystemBackdropElement.SystemBackdrop><local:PanelAcrylicBackdrop /></SystemBackdropElement.SystemBackdrop>
   </SystemBackdropElement>
   <Border CornerRadius="{ThemeResource OverlayCornerRadius}"
           Background="{ThemeResource PanelBrightnessBrush}" IsHitTestVisible="False" />
   <Frame x:Name="ContentFrame" CacheSize="2" IsNavigationStackEnabled="False" Background="Transparent" />
   <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <!-- Fixed main surface. Only an overflowing device list can scroll. -->
    <Grid Padding="24,24,24,12" Visibility="{x:Bind ViewModel.ConnectedPageVisibility, Mode=OneWay}">
     <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" />
     </Grid.RowDefinitions>
     <Grid ColumnSpacing="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel Spacing="4">
       <Button x:Name="HeadsetHeaderButton" Click="OnSwitchHeadset" Style="{StaticResource HeadsetHeaderButtonStyle}"
               ToolTipService.ToolTip="{x:Bind ViewModel.HeadsetSwitchToolTip, Mode=OneWay}"
               AutomationProperties.Name="{x:Bind ViewModel.HeadsetSwitchToolTip, Mode=OneWay}">
       <Grid ColumnSpacing="6" IsHitTestVisible="False">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind ViewModel.HeadsetName, Mode=OneWay}" TextTrimming="CharacterEllipsis"
                  FontWeight="SemiBold" Style="{StaticResource SubtitleTextBlockStyle}" />
        <FontIcon Grid.Column="1" Glyph="&#xE76C;" FontSize="12" VerticalAlignment="Center" />
       </Grid>
       </Button>
       <TextBlock x:Name="MenuCopy" FontSize="13" FontWeight="Medium" TextTrimming="CharacterEllipsis"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <Border Grid.Column="1" VerticalAlignment="Top" CornerRadius="4" Padding="8,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
       <TextBlock Text="{x:Bind ViewModel.ConnectionLabel, Mode=OneWay}" FontWeight="Medium" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Border>
     </Grid>

     <StackPanel Grid.Row="1" Spacing="8" Margin="0,24,0,0" Visibility="{x:Bind ViewModel.GlobalBatteryVisibility, Mode=OneWay}">
      <FontIcon Glyph="&#xE7F6;" FontSize="28" HorizontalAlignment="Center" />
      <TextBlock Text="{x:Bind ViewModel.GlobalBattery.Text, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <ProgressBar Value="{x:Bind ViewModel.GlobalBattery.Value, Mode=OneWay}" Visibility="{x:Bind ViewModel.GlobalBattery.BarVisibility, Mode=OneWay}" Maximum="100" IsTabStop="False" />
      <TextBlock Text="耳机整体电量" FontSize="13" HorizontalAlignment="Center" />
     </StackPanel>
     <Grid Grid.Row="1" ColumnSpacing="20" Margin="0,24,0,0" AutomationProperties.Name="耳机电量" Visibility="{x:Bind ViewModel.SplitBatteryVisibility, Mode=OneWay}">
      <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition /><ColumnDefinition /></Grid.ColumnDefinitions>
      <StackPanel Spacing="8">
       <local:ProductIcon Kind="LeftEar" Width="28" Height="28" HorizontalAlignment="Center" AutomationProperties.Name="左耳机" />
       <TextBlock Text="{x:Bind ViewModel.LeftBattery.Text, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
       <ProgressBar Value="{x:Bind ViewModel.LeftBattery.Value, Mode=OneWay}" Visibility="{x:Bind ViewModel.LeftBattery.BarVisibility, Mode=OneWay}"
                    Maximum="100" IsTabStop="False" AutomationProperties.Name="{x:Bind ViewModel.LeftBattery.AccessibleText, Mode=OneWay}" />
       <TextBlock Text="{x:Bind ViewModel.LeftBattery.Label, Mode=OneWay}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="1" Spacing="8">
       <local:ProductIcon Kind="RightEar" Width="28" Height="28" HorizontalAlignment="Center" AutomationProperties.Name="右耳机" />
       <TextBlock Text="{x:Bind ViewModel.RightBattery.Text, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
       <ProgressBar Value="{x:Bind ViewModel.RightBattery.Value, Mode=OneWay}" Visibility="{x:Bind ViewModel.RightBattery.BarVisibility, Mode=OneWay}"
                    Maximum="100" IsTabStop="False" AutomationProperties.Name="{x:Bind ViewModel.RightBattery.AccessibleText, Mode=OneWay}" />
       <TextBlock Text="{x:Bind ViewModel.RightBattery.Label, Mode=OneWay}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
      <StackPanel Grid.Column="2" Spacing="8">
       <local:ProductIcon Kind="ChargingCase" Width="28" Height="28" HorizontalAlignment="Center" AutomationProperties.Name="耳机充电盒" />
       <TextBlock Text="{x:Bind ViewModel.CaseBattery.Text, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
       <ProgressBar Value="{x:Bind ViewModel.CaseBattery.Value, Mode=OneWay}" Visibility="{x:Bind ViewModel.CaseBattery.BarVisibility, Mode=OneWay}"
                    Maximum="100" IsTabStop="False" AutomationProperties.Name="{x:Bind ViewModel.CaseBattery.AccessibleText, Mode=OneWay}" />
       <TextBlock Text="{x:Bind ViewModel.CaseBattery.Label, Mode=OneWay}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </StackPanel>
     </Grid>

     <Grid Grid.Row="2" Margin="0,10,0,0" ColumnSpacing="16"
           Visibility="{x:Bind ViewModel.NoiseControlVisibility, Mode=OneWay}">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <TextBlock Text="噪声控制" FontSize="14" VerticalAlignment="Center" />
      <ComboBox x:Name="NoiseModeSelector" Grid.Column="1" Width="150" HorizontalAlignment="Right"
                ItemsSource="{x:Bind ViewModel.NoiseChoices}" DisplayMemberPath="Label" PlaceholderText="状态未知"
                IsEnabled="{x:Bind ViewModel.CanChangeNoiseControl, Mode=OneWay}"
                AutomationProperties.Name="噪声控制模式" SelectionChanged="OnNoiseModeSelected"
                DropDownOpened="OnNoiseDropDownOpened" DropDownClosed="OnNoiseDropDownClosed" />
      <Grid Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" ColumnSpacing="16"
            Visibility="{x:Bind ViewModel.NoiseLevelVisibility, Mode=OneWay}">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
       <TextBlock Text="降噪强度" FontSize="14" VerticalAlignment="Center" />
       <ComboBox x:Name="NoiseLevelSelector" Grid.Column="1" Width="150" HorizontalAlignment="Right"
                 DisplayMemberPath="Label" PlaceholderText="强度未知"
                 IsEnabled="{x:Bind ViewModel.CanChangeNoiseLevel, Mode=OneWay}"
                 AutomationProperties.Name="降噪强度" SelectionChanged="OnNoiseLevelSelected"
                 DropDownOpened="OnNoiseDropDownOpened" DropDownClosed="OnNoiseDropDownClosed" />
      </Grid>
     </Grid>

     <Border Grid.Row="3" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
             Margin="-24,10,-24,0" Padding="24,10,24,8" Visibility="{x:Bind ViewModel.DeviceManagementVisibility, Mode=OneWay}">
      <Grid>
       <TextBlock Text="已配对设备" FontSize="14" FontWeight="SemiBold" />
       <TextBlock Text="{x:Bind ViewModel.ConnectionSummary, Mode=OneWay}" FontSize="13" FontWeight="Medium" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
     </Border>
     <ListView x:Name="DeviceList" Grid.Row="4" ItemsSource="{x:Bind ViewModel.Devices}" SelectionMode="Single"
               Visibility="{x:Bind ViewModel.DeviceManagementVisibility, Mode=OneWay}"
               SelectionChanged="OnDeviceSelectionChanged"
               Background="Transparent" BorderThickness="0" Margin="-16,0,-16,0"
               ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.IsVerticalScrollChainingEnabled="False">
      <ListView.ItemContainerStyle>
       <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="12,10" />
        <Setter Property="Margin" Value="0,2" /><Setter Property="MinHeight" Value="64" />
       </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
       <DataTemplate x:DataType="local:DeviceInfo">
        <Grid ColumnSpacing="12" Padding="4,0,0,0">
         <Grid.ContextFlyout>
          <MenuFlyout Opened="OnMenuOpened" Closed="OnMenuClosed">
           <MenuFlyoutSubItem Text="设备类型">
            <MenuFlyoutItem Text="自动识别" Tag="{x:Bind}" Click="OnTypeAuto" />
            <MenuFlyoutItem Text="电脑" Tag="{x:Bind}" Click="OnTypeComputer" />
            <MenuFlyoutItem Text="手机" Tag="{x:Bind}" Click="OnTypePhone" />
            <MenuFlyoutItem Text="平板" Tag="{x:Bind}" Click="OnTypeTablet" />
           </MenuFlyoutSubItem>
          </MenuFlyout>
         </Grid.ContextFlyout>
         <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
         <Grid Grid.ColumnSpan="2" ColumnSpacing="12" Opacity="{x:Bind ContentOpacity, Mode=OneWay}" Background="Transparent"
               ToolTipService.ToolTip="{x:Bind TypeDescription, Mode=OneWay}">
          <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <local:ProductIcon Kind="{x:Bind IconKey, Mode=OneWay}" IsConnected="{x:Bind IsActive, Mode=OneWay}" Width="32" Height="32" VerticalAlignment="Center"
                             AutomationProperties.Name="{x:Bind TypeDescription, Mode=OneWay}" />
          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
           <TextBlock Text="{x:Bind Name, Mode=OneWay}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
           <TextBlock Text="{x:Bind Status, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
          <Button Grid.Column="2" Tag="{x:Bind}" Click="OnConnectionLock" Style="{StaticResource SubtleButtonStyle}"
                  Visibility="{x:Bind LockButtonVisibility, Mode=OneWay}" IsEnabled="{x:Bind CanChangeConnectionLock, Mode=OneWay}"
                  Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="4" VerticalAlignment="Top"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="Transparent"
                  ToolTipService.ToolTip="{x:Bind LockActionLabel, Mode=OneWay}" AutomationProperties.Name="{x:Bind LockActionLabel, Mode=OneWay}">
           <FontIcon Glyph="{x:Bind LockGlyph, Mode=OneWay}" FontSize="16" IsHitTestVisible="False" />
          </Button>
         </Grid>
         <Button Grid.Row="1" Grid.Column="1" Content="{x:Bind ActionLabel, Mode=OneWay}" Tag="{x:Bind}" FontSize="14" FontWeight="Medium"
                 Visibility="{x:Bind ActionVisibility, Mode=OneWay}" HorizontalAlignment="Right" Margin="0,12,0,0"
                 Click="OnDeviceAction" MinWidth="184" />
        </Grid>
       </DataTemplate>
      </ListView.ItemTemplate>
     </ListView>
     <TextBlock Grid.Row="4" Text="设备连接请在 Windows 蓝牙设置中管理。" TextWrapping="Wrap" FontSize="14" Margin="0,20,0,0"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ViewModel.NoDeviceManagementVisibility, Mode=OneWay}" />
     <TextBlock Grid.Row="5" Text="{x:Bind ViewModel.Message, Mode=OneWay}" Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}"
                FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"
                ToolTipService.ToolTip="{x:Bind ViewModel.Message, Mode=OneWay}" />
    </Grid>

    <Grid Padding="24,24,24,12" Visibility="{x:Bind ViewModel.ConnectionNoticeVisibility, Mode=OneWay}">
     <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
     <TextBlock Text="蓝牙" FontSize="16" FontWeight="Medium" />
     <Button Click="OnSwitchHeadset" Style="{StaticResource SubtleButtonStyle}" HorizontalAlignment="Right" Width="28" Height="28" MinWidth="28" MinHeight="28" Padding="4"
             AutomationProperties.Name="切换耳机" ToolTipService.ToolTip="切换耳机"><FontIcon Glyph="&#xE76C;" FontSize="12" /></Button>
     <StackPanel Grid.Row="1" VerticalAlignment="Center" Spacing="12" AutomationProperties.LiveSetting="Polite">
      <TextBlock Text="{x:Bind ViewModel.ConnectionNoticeTitle, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
      <TextBlock Text="{x:Bind ViewModel.ConnectionNoticeDescription, Mode=OneWay}" FontSize="15" FontWeight="Medium" TextWrapping="Wrap" />
     </StackPanel>
    </Grid>

    <Border Grid.Row="1" Padding="16,8" Background="{ThemeResource SubtleFillColorTertiaryBrush}" CornerRadius="0,0,8,8"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="BluetoothSettingsButton" Click="OnOpenBluetoothSettings" Style="{StaticResource SubtleButtonStyle}"
              HorizontalAlignment="Left" VerticalAlignment="Center" Padding="8,6" MinHeight="32"
              ToolTipService.ToolTip="{x:Bind ViewModel.BluetoothFooterAction, Mode=OneWay}" AutomationProperties.Name="{x:Bind ViewModel.BluetoothFooterAction, Mode=OneWay}">
       <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <FontIcon Glyph="&#xE702;" FontSize="16" Visibility="{x:Bind ViewModel.ConnectedPageVisibility, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.BluetoothFooterLabel, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                   FontSize="13" FontWeight="Medium" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
       </StackPanel>
      </Button>
      <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefresh" IsEnabled="{x:Bind ViewModel.CanRefresh, Mode=OneWay}" Style="{StaticResource SubtleButtonStyle}"
              Visibility="{x:Bind ViewModel.ConnectedPageVisibility, Mode=OneWay}"
              HorizontalAlignment="Right" ToolTipService.ToolTip="刷新设备数据" AutomationProperties.Name="刷新设备数据">
       <FontIcon Glyph="&#xE72C;" FontSize="16" />
      </Button>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</UserControl>
