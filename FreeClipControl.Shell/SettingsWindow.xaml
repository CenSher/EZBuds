<Window
    x:Class="FreeClipControl.Shell.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:FreeClipControl.Shell"
    xmlns:animated="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    Title="EZBuds · 设置">
    <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="SettingsCard" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,18" />
            </Style>
            <Style x:Key="CardDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <!-- Keep the WinUI template: the fallback template reserves a much
                 wider content area even with MinWidth=0 on the control itself. -->
            <Style x:Key="SettingsToggle" TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="OnContent" Value="" />
                <Setter Property="OffContent" Value="" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="SettingsExpanderHeader" TargetType="ToggleButton">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
                <Setter Property="UseSystemFocusVisuals" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Grid x:Name="HeaderSurface" Background="{TemplateBinding Background}"
                                  BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                  CornerRadius="{TemplateBinding CornerRadius}" MinHeight="{TemplateBinding MinHeight}"
                                  Control.IsTemplateFocusTarget="True">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal">
                                            <VisualState.Setters><Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOff" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="PointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderHighlight.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOff" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderHighlight.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOff" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Disabled">
                                            <VisualState.Setters><Setter Target="HeaderSurface.Opacity" Value="0.4" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="Checked">
                                            <VisualState.Setters><Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOn" /></VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPointerOver">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderHighlight.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                                <Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOn" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedPressed">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderHighlight.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                                <Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOn" />
                                            </VisualState.Setters>
                                        </VisualState>
                                        <VisualState x:Name="CheckedDisabled">
                                            <VisualState.Setters>
                                                <Setter Target="HeaderSurface.Opacity" Value="0.4" />
                                                <Setter Target="Chevron.(AnimatedIcon.State)" Value="NormalOn" />
                                            </VisualState.Setters>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Border x:Name="HeaderHighlight" Background="Transparent" CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
                                <Grid Padding="{TemplateBinding Padding}" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                      HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                                      Foreground="{TemplateBinding Foreground}" />
                                    <!-- Decorative indicator: the entire header is the click target. -->
                                    <AnimatedIcon x:Name="Chevron" Grid.Column="1" Width="12" Height="12"
                                                  VerticalAlignment="Center" IsHitTestVisible="False"
                                                  AutomationProperties.AccessibilityView="Raw" AnimatedIcon.State="NormalOff">
                                        <animated:AnimatedChevronUpDownSmallVisualSource />
                                        <AnimatedIcon.FallbackIconSource><FontIconSource Glyph="&#xE70D;" FontSize="12" /></AnimatedIcon.FallbackIconSource>
                                    </AnimatedIcon>
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <TitleBar x:Name="AppTitleBar" Title="EZBuds · 设置" />
        <NavigationView x:Name="Navigation" Grid.Row="1" IsSettingsVisible="False"
                        IsBackButtonVisible="Collapsed" PaneDisplayMode="Auto"
                        ExpandedModeThresholdWidth="900" CompactModeThresholdWidth="640"
                        SelectionChanged="OnNavigationChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="DeviceItem" Content="蓝牙和设备" Tag="device">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE702;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="ConfigurationItem" Content="耳机配置" Tag="configuration">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE713;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="个性化" Tag="appearance">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE790;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="关于" Tag="about">
                    <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <ScrollViewer x:Name="PageScroll" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                          HorizontalContentAlignment="Stretch" VerticalContentAlignment="Top">
                <Grid x:Name="ContentViewport" Margin="32,20,32,36" HorizontalAlignment="Stretch" SizeChanged="OnContentViewportSizeChanged">
                <StackPanel x:Name="PageContent" Spacing="24" MaxWidth="1000" HorizontalAlignment="Center">
                    <TextBlock x:Name="PageTitle" Text="蓝牙和设备" Style="{ThemeResource TitleTextBlockStyle}" />
                    <Grid x:Name="ConfigurationPage" RowSpacing="12" VerticalAlignment="Top" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border x:Name="HeadsetConfigurationCard" Grid.Row="0" VerticalAlignment="Top" Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="选择耳机和型号" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock Text="先在 Windows 中配对耳机。型号会按耳机地址记住，改名后仍可识别；选择其他耳机后点击应用。" Style="{StaticResource CardDescription}" />
                                <ComboBox x:Name="HeadsetSelector" Header="已配对的蓝牙设备" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanSelectHeadset, Mode=OneWay}"
                                          SelectionChanged="OnHeadsetChanged">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="local:HeadsetChoice"><TextBlock Text="{x:Bind DisplayName}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <ComboBox x:Name="ModelSelector" Header="耳机型号" HorizontalAlignment="Stretch" IsEnabled="{x:Bind ViewModel.CanSelectHeadset, Mode=OneWay}"
                                          SelectionChanged="OnModelChanged">
                                    <ComboBox.ItemTemplate><DataTemplate x:DataType="local:HeadsetProfile"><TextBlock Text="{x:Bind Name}" /></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBlock x:Name="ModelHelp" Style="{StaticResource CardDescription}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="应用到这副耳机" Click="OnApplyHeadset" IsEnabled="{x:Bind ViewModel.CanSelectHeadset, Mode=OneWay}" />
                                    <Button Content="刷新设备列表" Click="OnReloadHeadsets" IsEnabled="{x:Bind ViewModel.CanSelectHeadset, Mode=OneWay}" />
                                    <TextBlock x:Name="ApplySuccessText" Text="配置添加成功，请到“蓝牙和设备”界面查看" Style="{StaticResource CardDescription}" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                                <InfoBar x:Name="HeadsetSelectionMessage" IsOpen="False" IsClosable="True" Severity="Informational" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="ModelCatalogCard" Grid.Row="1" VerticalAlignment="Top" Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="12">
                                <TextBlock Text="耳机型号库" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="CatalogSummary" Style="{StaticResource CardDescription}" />
                                <TextBlock Text="导入自定义型号配置，或从 OpenFreebuds 获取新的型号适配信息。更新失败时会保留现有配置。" Style="{StaticResource CardDescription}" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="ImportModelButton" Content="导入自定义配置" Click="OnImportModels" />
                                    <Button x:Name="UpdateModelButton" Content="从 OpenFreebuds 更新" Click="OnUpdateModels" />
                                </StackPanel>
                                <ProgressRing x:Name="CatalogProgress" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" Visibility="Collapsed" />
                                <InfoBar x:Name="CatalogMessage" IsOpen="False" IsClosable="True" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="DevicePage" RowSpacing="24" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <local:SettingsExpander x:Name="SelectedHeadsetCard" Grid.Row="0" Grid.ColumnSpan="2" IsExpanded="False" CornerRadius="8"
                                  HeaderButtonStyle="{StaticResource SettingsExpanderHeader}"
                                  HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                  AutomationProperties.Name="当前耳机，展开切换或管理已配置的耳机">
                            <local:SettingsExpander.Header>
                                <Grid ColumnSpacing="20" MinHeight="88">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE7F6;" FontSize="32" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.SelectedHeadsetTitle, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" TextWrapping="Wrap" />
                                        <TextBlock Text="{x:Bind ViewModel.SelectedHeadsetStatus, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.SelectedHeadsetVisibility, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind ViewModel.HeadsetAddress, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                                            <TextBlock Text="{x:Bind ViewModel.ModelDescription, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </local:SettingsExpander.Header>
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="已配置的耳机" Style="{ThemeResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="添加耳机" Click="OnConfigureHeadset" />
                                </Grid>
                                <TextBlock Text="切换要查看的耳机，或管理已保存的配置。删除配置会保留 Windows 蓝牙配对。" Style="{StaticResource CardDescription}" />
                                <TextBlock Text="还没有配置耳机，请点击添加耳机选择蓝牙设备和型号。" Style="{StaticResource CardDescription}" Visibility="{x:Bind ViewModel.NoBindingsVisibility, Mode=OneWay}" />
                                <ItemsControl ItemsSource="{x:Bind ViewModel.BoundHeadsets}" IsEnabled="{x:Bind ViewModel.CanSelectHeadset, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:BoundHeadset">
                                        <Border Padding="0,12,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
                                            <Grid ColumnSpacing="16" RowSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                                <FontIcon Glyph="&#xE7F6;" FontSize="24" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Spacing="4">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{x:Bind Detail}" Style="{StaticResource CardDescription}" />
                                                    <TextBlock Text="{x:Bind AddressText}" Style="{StaticResource CardDescription}" />
                                                </StackPanel>
                                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                    <Button Content="切换" Tag="{x:Bind}" IsEnabled="{x:Bind CanSwitch}" Click="OnUseBoundHeadset" />
                                                    <Button Content="修改" Tag="{x:Bind}" Click="OnEditBoundHeadset" />
                                                    <Button Content="删除" Tag="{x:Bind}" Click="OnDeleteBoundHeadset" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <InfoBar x:Name="BindingMessage" IsOpen="False" IsClosable="True" Severity="Error"
                                         Visibility="{x:Bind BindingMessage.IsOpen, Mode=OneWay}" />
                            </StackPanel>
                        </local:SettingsExpander>
                        <StackPanel x:Name="BatterySection" Grid.Row="1" Spacing="8" VerticalAlignment="Top" Visibility="{x:Bind ViewModel.SelectedHeadsetVisibility, Mode=OneWay}">
                            <TextBlock Text="耳机电量" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource SettingsCard}" Visibility="{x:Bind ViewModel.GlobalBatteryVisibility, Mode=OneWay}">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="耳机整体电量" Style="{StaticResource CardDescription}" />
                                    <TextBlock Text="{x:Bind ViewModel.GlobalBattery.Text, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                </StackPanel>
                            </Border>
                            <Grid ColumnSpacing="8" Visibility="{x:Bind ViewModel.SplitBatteryVisibility, Mode=OneWay}">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.LeftBattery.Label, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                                        <TextBlock Text="{x:Bind ViewModel.LeftBattery.Text, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.RightBattery.Label, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                                        <TextBlock Text="{x:Bind ViewModel.RightBattery.Text, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="{x:Bind ViewModel.CaseBattery.Label, Mode=OneWay}" Style="{StaticResource CardDescription}" />
                                        <TextBlock Text="{x:Bind ViewModel.CaseBattery.Text, Mode=OneWay}" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                        <StackPanel x:Name="ConnectionSection" Grid.Row="2" Spacing="8" VerticalAlignment="Top">
                            <TextBlock Text="连接" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="连接到耳机" TextWrapping="Wrap" />
                                        <TextBlock Text="其他设备正在使用耳机时，请求将音频切换到这台电脑。" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="连接" Click="OnConnect" IsEnabled="{x:Bind ViewModel.CanConnectToHeadset, Mode=OneWay}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="设备管理" />
                                        <TextBlock Text="查看已连接的设备，管理耳机连接。" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开控制面板" Click="OnOpenPanel" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="Windows 蓝牙设置" />
                                        <TextBlock Text="配对耳机或管理电脑的蓝牙设备。" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="打开设置" Click="OnOpenBluetooth" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Padding="16" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" CornerRadius="8"
                                    Visibility="{x:Bind ViewModel.StatusVisibility, Mode=OneWay}">
                                <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AppearancePage" RowSpacing="24" VerticalAlignment="Top" Visibility="Collapsed">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="0" /></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <StackPanel x:Name="AppearancePrimaryColumn" Grid.Row="0" Spacing="24" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <TextBlock Text="外观" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="应用主题" />
                                        <TextBlock Text="选择控制面板和设置窗口的外观。" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                    <ComboBox x:Name="ThemeSelector" Grid.Column="1" MinWidth="148" VerticalAlignment="Center"
                                              AutomationProperties.Name="应用主题" SelectionChanged="OnThemeChanged">
                                        <ComboBoxItem Content="跟随系统" /><ComboBoxItem Content="浅色" /><ComboBoxItem Content="深色" />
                                    </ComboBox>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="主菜单文案" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <local:SettingsExpander x:Name="CopyExpander" IsExpanded="False" MinHeight="76" CornerRadius="8"
                                      HeaderButtonStyle="{StaticResource SettingsExpanderHeader}" HeaderPadding="20,14,20,14"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <local:SettingsExpander.Header>
                                    <Grid ColumnSpacing="20" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="抽象文案" />
                                            <TextBlock x:Name="CopyDescription" Style="{StaticResource CardDescription}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="AbstractCopyState" Text="开" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="AbstractCopyToggle" Style="{StaticResource SettingsToggle}" MinWidth="0"
                                                          AutomationProperties.Name="抽象文案" Toggled="OnAbstractCopyToggled" />
                                        </StackPanel>
                                    </Grid>
                                </local:SettingsExpander.Header>
                                <StackPanel Spacing="16">
                                    <TextBlock x:Name="CopyCount" Style="{StaticResource CardDescription}" />
                                    <TextBlock Text="导入 UTF-8 TXT 文件，每行一条。新文案会追加到当前耳机品牌的文案库，自动忽略空行和重复文案；每条最多 200 个字符，每个品牌最多导入 1000 条。" Style="{StaticResource CardDescription}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="ImportCopyButton" Content="导入文案" Click="OnImportCopy" />
                                        <Button x:Name="ResetCopyButton" Content="恢复内置文案" Click="OnResetCopy" />
                                    </StackPanel>
                                    <InfoBar x:Name="CopyImportMessage" IsOpen="False" IsClosable="True" />
                                </StackPanel>
                            </local:SettingsExpander>
                        </StackPanel>
                        </StackPanel>
                        <StackPanel x:Name="AppearanceSecondaryColumn" Grid.Row="1" Spacing="24" VerticalAlignment="Top">
                        <StackPanel Spacing="8">
                            <TextBlock Text="启动" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <local:SettingsExpander x:Name="StartupExpander" IsExpanded="False" MinHeight="76" CornerRadius="8"
                                      HeaderButtonStyle="{StaticResource SettingsExpanderHeader}" HeaderPadding="20,14,20,14"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <local:SettingsExpander.Header>
                                    <Grid ColumnSpacing="20" MinHeight="44">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Spacing="4" VerticalAlignment="Center">
                                            <TextBlock Text="开机自启动" TextWrapping="Wrap" />
                                            <TextBlock Text="登录 Windows 后自动驻留系统托盘，不打开面板。仅对当前用户生效。" Style="{StaticResource CardDescription}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                            <TextBlock x:Name="StartupState" Text="关" VerticalAlignment="Center" />
                                            <ToggleSwitch x:Name="StartupToggle" Style="{StaticResource SettingsToggle}" AutomationProperties.Name="开机自启动" Toggled="OnStartupToggled" />
                                        </StackPanel>
                                    </Grid>
                                </local:SettingsExpander.Header>
                                <StackPanel Spacing="12">
                                    <TextBlock Text="此开关管理自启动注册；如果已在 Windows 中禁用，请到系统启动设置中启用。移动或更新便携版目录后，请重新注册当前位置；删除软件前请先关闭此开关。" Style="{StaticResource CardDescription}" />
                                    <Button x:Name="RepairStartupButton" Content="将自启动更新为当前位置" Visibility="Collapsed" Click="OnRepairStartup" />
                                    <HyperlinkButton Content="Windows 启动设置" Click="OnOpenWindowsStartup" Padding="0" />
                                </StackPanel>
                            </local:SettingsExpander>
                            <InfoBar x:Name="StartupMessage" IsOpen="False" IsClosable="True" Severity="Error" />
                        </StackPanel>
                        <StackPanel Spacing="8">
                            <TextBlock Text="系统托盘" Style="{ThemeResource BodyStrongTextBlockStyle}" Margin="0,0,0,4" />
                            <Border Style="{StaticResource SettingsCard}">
                                <Grid ColumnSpacing="20">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="悬浮查看耳机电量" TextWrapping="Wrap" />
                                        <TextBlock Text="鼠标悬停托盘时显示耳机电量。关闭后停止后台刷新，有助于节省内存。" Style="{StaticResource CardDescription}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="TrayBatteryState" Text="开" VerticalAlignment="Center" />
                                        <ToggleSwitch x:Name="TrayBatteryToggle" Style="{StaticResource SettingsToggle}" MinWidth="0"
                                                      AutomationProperties.Name="悬浮查看耳机电量" Toggled="OnTrayBatteryToggled" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        </StackPanel>
                        <InfoBar x:Name="PreferenceError" Grid.Row="2" Grid.ColumnSpan="2" IsOpen="False" IsClosable="True" Severity="Error" />
                    </Grid>
                    <StackPanel x:Name="AboutPage" Spacing="8" Visibility="Collapsed">
                        <Border Style="{StaticResource SettingsCard}">
                            <StackPanel Spacing="8">
                                <TextBlock Text="EZBuds" Style="{ThemeResource SubtitleTextBlockStyle}" />
                                <TextBlock x:Name="AboutVersion" Style="{StaticResource CardDescription}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
