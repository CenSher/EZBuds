<UserControl x:Class="FreeClipControl.Shell.ProductIcon"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" IsHitTestVisible="False">
 <Viewbox Stretch="Uniform">
  <Grid Width="32" Height="32">
   <Grid x:Name="DeviceDrawing">
    <Ellipse x:Name="ActiveBadge" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Ellipse x:Name="InactiveBadge" Fill="{ThemeResource SubtleFillColorSecondaryBrush}" />
    <Grid x:Name="ActiveDevice">
     <Grid x:Name="ActivePhone">
      <Path Data="M12,8 L20,8 L20,24 L12,24 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
      <Path Data="M12,5 L20,5 Q22,5 22,7 L22,25 Q22,27 20,27 L12,27 Q10,27 10,25 L10,7 Q10,5 12,5 Z M22,11 L23,11 L23,16 L22,16" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
     <Grid x:Name="ActiveTablet">
      <Path Data="M8,11 L24,11 L24,22 L8,22 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
      <Path Data="M7,8 L25,8 Q28,8 28,11 L28,22 Q28,25 25,25 L7,25 Q4,25 4,22 L4,11 Q4,8 7,8 Z" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
     <Grid x:Name="ActiveComputer">
      <Path Data="M9,10 L23,10 L23,20 L9,20 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
      <Path Data="M8,7 L24,7 Q26,7 26,9 L26,22 L6,22 L6,9 Q6,7 8,7 Z M3,25 L29,25 M11,23 L21,23" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
     <Grid x:Name="ActiveUnknown">
      <Path Data="M11,10 L22,21 L16,27 L16,5 L22,11 L11,22" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
    </Grid>
    <Grid x:Name="InactiveDevice">
     <Grid x:Name="InactivePhone">
      <Path Data="M12,8 L20,8 L20,24 L12,24 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
      <Path Data="M12,5 L20,5 Q22,5 22,7 L22,25 Q22,27 20,27 L12,27 Q10,27 10,25 L10,7 Q10,5 12,5 Z M22,11 L23,11 L23,16 L22,16" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
     <Grid x:Name="InactiveTablet">
      <Path Data="M8,11 L24,11 L24,22 L8,22 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
      <Path Data="M7,8 L25,8 Q28,8 28,11 L28,22 Q28,25 25,25 L7,25 Q4,25 4,22 L4,11 Q4,8 7,8 Z" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
     <Grid x:Name="InactiveComputer">
      <Path Data="M9,10 L23,10 L23,20 L9,20 Z" Fill="{ThemeResource TextFillColorSecondaryBrush}" Opacity="0.35" />
      <Path Data="M8,7 L24,7 Q26,7 26,9 L26,22 L6,22 L6,9 Q6,7 8,7 Z M3,25 L29,25 M11,23 L21,23" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
     <Grid x:Name="InactiveUnknown">
      <Path Data="M11,10 L22,21 L16,27 L16,5 L22,11 L11,22" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="1.6" StrokeLineJoin="Round" />
     </Grid>
    </Grid>
   </Grid>
   <Grid x:Name="LeftEarDrawing">
    <Path Data="M19,8 C8,3 3,13 7,22 C9,27 14,27 18,25" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    <Ellipse Width="10" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,3,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
    <Border Width="14" Height="9" CornerRadius="4.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,20,0,0" Background="{ThemeResource TextFillColorSecondaryBrush}" />
    <TextBlock Text="L" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   </Grid>
   <Grid x:Name="RightEarDrawing">
    <Grid RenderTransformOrigin="0.5,0.5">
     <Grid.RenderTransform><ScaleTransform ScaleX="-1" /></Grid.RenderTransform>
     <Path Data="M19,8 C8,3 3,13 7,22 C9,27 14,27 18,25" Stroke="{ThemeResource TextFillColorSecondaryBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
     <Ellipse Width="10" Height="11" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,3,0,0" Fill="{ThemeResource TextFillColorSecondaryBrush}" />
     <Border Width="14" Height="9" CornerRadius="4.5" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,20,0,0" Background="{ThemeResource TextFillColorSecondaryBrush}" />
    </Grid>
    <TextBlock Text="R" FontSize="8" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Bottom" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
   </Grid>
   <Grid x:Name="CaseDrawing">
    <Border Width="24" Height="26" CornerRadius="8" Background="{ThemeResource TextFillColorSecondaryBrush}" />
    <Path Data="M4,13 L28,13" Stroke="{ThemeResource SolidBackgroundFillColorBaseBrush}" StrokeThickness="1.8" />
   </Grid>
  </Grid>
 </Viewbox>
</UserControl>
